{
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "cspell": "^10.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "@changesets/cli": "^2.31.0",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "open-cli": "^9.0.0",
    "prettier": "^3.8.3",
    "resolve.exports": "^2.0.3",
    "rimraf": "^6.1.3",
    "run-script-os": "^1.1.6",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "release:publish": "pnpm exec changeset publish && git push --follow-tags origin main",
    "prerelease:publish": "pnpm exec changeset publish --tag next",
    "release:publish:dry-run": "pnpm exec changeset publish --tag next --registry=\"http://localhost:4873/\" --dry-run",
    "release:version": "pnpm exec changeset version",
    "prerelease:version": "pnpm exec changeset version --prerelease",
    "doc": "run-s doc:html && open-cli build/docs/index.html",
    "doc:open": "open-cli build/docs/index.html",
    "doc:html": "typedoc --name novastar.js --entryPointStrategy packages --entryPoints packages/codec --entryPoints packages/native --entryPoints packages/net --entryPoints packages/serial --entryPoints packages/screen --entryPoints packages/taurus --categorizeByGroup true --excludeProtected --excludePrivate --out build/docs",
    "doc:publish": "gh-pages -m \"[ci skip] Updates\" -t -d build/docs",
    "yalc:push": "pnpm -w -r run yalc:push"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
